{
	"name": "christina",
	"version": "0.9.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YOUR_GITHUB_USERNAME/christina.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"dotenv-cli": "^11.0.0",
		"sherif": "^1.10.0",
		"tsx": "^4.20.6",
		"turbo": "^2.8.7"
	},
	"description": "CHRISTINA: local-first multi-agent orchestration with local models and private agent-scoped book libraries",
	"homepage": "https://github.com/YOUR_GITHUB_USERNAME/christina#readme",
	"license": "SEE LICENSE IN LICENSE.md",
	"packageManager": "pnpm@10.0.0",
	"private": true,
	"scripts": {
		"dev": "turbo run dev dev:caddy --filter=@superset/api --filter=@superset/web --filter=@ade/desktop --filter=//",
		"dev:all": "turbo dev",
		"dev:caddy": "dotenv -- caddy run --config Caddyfile",
		"dev:docs": "turbo dev --filter=@superset/docs",
		"dev:marketing": "turbo dev --filter=@superset/marketing --filter=@superset/docs",
		"build": "turbo build --filter=@ade/desktop",
		"test": "turbo test",
		"lint": "tsx scripts/lint.ts",
		"lint:fix": "biome migrate --write && biome check --write --unsafe .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "turbo typecheck",
		"ui-add": "turbo run ui-add",
		"postinstall": "tsx scripts/postinstall.ts",
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"release:desktop": "tsx scripts/release-desktop.ts",
		"release:canary": "tsx scripts/release-canary.ts",
		"db:push": "pnpm --filter @superset/db push",
		"db:migrate": "pnpm --filter @superset/db migrate",
		"db:generate:desktop": "pnpm --filter @superset/local-db generate",
		"dev:desktop": "pnpm --filter @ade/desktop dev",
		"local:models": "tsx scripts/christina-local.ts models",
		"local:ask": "tsx scripts/christina-local.ts ask",
		"local:orchestrate": "tsx scripts/christina-local.ts orchestrate",
		"doctor:runtime": "tsx scripts/christina-runtime.ts doctor",
		"doctor:runtime:json": "tsx scripts/christina-runtime.ts doctor --json",
		"doctor:report": "tsx scripts/christina-runtime.ts doctor --out reports/doctor-runtime.json",
		"profile:init": "tsx scripts/christina-runtime.ts profile:init",
		"profile:recommend": "tsx scripts/christina-runtime.ts recommend",
		"profile:auto": "tsx scripts/christina-runtime.ts profile:init",
		"schedule:add": "tsx scripts/christina-scheduler.ts add",
		"schedule:list": "tsx scripts/christina-scheduler.ts list",
		"schedule:run-due": "tsx scripts/christina-scheduler.ts run-due",
		"schedule:pause": "tsx scripts/christina-scheduler.ts pause",
		"schedule:resume": "tsx scripts/christina-scheduler.ts resume",
		"schedule:remove": "tsx scripts/christina-scheduler.ts remove",
		"tasks:create": "tsx scripts/christina-tasks.ts create",
		"tasks:list": "tsx scripts/christina-tasks.ts list",
		"tasks:run": "tsx scripts/christina-tasks.ts run",
		"books:list": "tsx scripts/christina-books.ts list",
		"books:add": "tsx scripts/christina-books.ts add",
		"books:scan": "tsx scripts/christina-books.ts scan",
		"books:agent": "tsx scripts/christina-books.ts agent",
		"books:ask": "tsx scripts/christina-books.ts ask",
		"books:remove": "tsx scripts/christina-books.ts remove"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"tooling/*"
	],
	"resolutions": {
		"mastracode": "https://github.com/superset-sh/mastra/releases/download/mastracode-v0.4.0-superset.7/mastracode-0.4.0-superset.7.tgz"
	},
	"patchedDependencies": {
		"@durable-streams/state@0.2.1": "patches/@durable-streams%2Fstate@0.2.1.patch"
	},
	"bugs": {
		"url": "https://github.com/YOUR_GITHUB_USERNAME/christina/issues"
	},
	"keywords": [
		"multi-agent",
		"orchestration",
		"local-llm",
		"ollama",
		"lm-studio",
		"rag",
		"electron",
		"typescript"
	],
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	}
}
